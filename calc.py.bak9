#!/usr/bin/env python3
"""
calc.py — Calculatrice live pour Termux
Ctrl+K pour ouvrir depuis .bashrc
"""

import ast
import curses
import operator
import math
import re
from collections import deque
import os
os.environ.setdefault("ESCDELAY", "25")

# ─── Conversions disponibles ───────────────────────────────────────────────
CONVERSIONS = {
    # Distance
    "km_miles":   ("km",   "miles",  lambda x: x * 0.621371),
    "miles_km":   ("miles","km",     lambda x: x * 1.60934),
    "m_ft":       ("m",    "ft",     lambda x: x * 3.28084),
    "ft_m":       ("ft",   "m",      lambda x: x / 3.28084),
    "cm_inch":    ("cm",   "inch",   lambda x: x / 2.54),
    "inch_cm":    ("inch", "cm",     lambda x: x * 2.54),
    # Température
    "c_f":        ("°C",   "°F",     lambda x: x * 9/5 + 32),
    "f_c":        ("°F",   "°C",     lambda x: (x - 32) * 5/9),
    "c_k":        ("°C",   "K",      lambda x: x + 273.15),
    # Poids
    "kg_lbs":     ("kg",   "lbs",    lambda x: x * 2.20462),
    "lbs_kg":     ("lbs",  "kg",     lambda x: x / 2.20462),
    "g_oz":       ("g",    "oz",     lambda x: x / 28.3495),
    # Vitesse
    "kmh_mph":    ("km/h", "mph",    lambda x: x * 0.621371),
    "mph_kmh":    ("mph",  "km/h",   lambda x: x * 1.60934),
    # Volume
    "l_gal":      ("L",    "gal",    lambda x: x * 0.264172),
    "gal_l":      ("gal",  "L",      lambda x: x / 0.264172),
}

# ─── Contexte mathématique sécurisé ────────────────────────────────────────
SAFE_MATH = {
    "sqrt": math.sqrt, "cbrt": lambda x: x**(1/3),
    "sin":  math.sin,  "cos":  math.cos,  "tan": math.tan,
    "asin": math.asin, "acos": math.acos, "atan": math.atan,
    "log":  math.log,  "log2": math.log2, "log10": math.log10,
    "exp":  math.exp,  "abs":  abs,       "round": round,
    "floor":math.floor,"ceil": math.ceil, "pow":   pow,
    "pi":   math.pi,   "e":    math.e,    "tau":   math.tau,
    "inf":  math.inf,
}

# ─── Évaluation ────────────────────────────────────────────────────────────
def try_conversion(expr):
    """Détecte ex: '100 km to miles' ou '37 c to f'"""
    expr = expr.strip().lower()
    patterns = [
        (r"([\d.]+)\s*km\s*(to|en|->)\s*miles?",   "km_miles"),
        (r"([\d.]+)\s*miles?\s*(to|en|->)\s*km",    "miles_km"),
        (r"([\d.]+)\s*m\s*(to|en|->)\s*ft",         "m_ft"),
        (r"([\d.]+)\s*ft\s*(to|en|->)\s*m",         "ft_m"),
        (r"([\d.]+)\s*cm\s*(to|en|->)\s*inch",      "cm_inch"),
        (r"([\d.]+)\s*inch\s*(to|en|->)\s*cm",      "inch_cm"),
        (r"([\d.]+)\s*°?c\s*(to|en|->)\s*°?f",      "c_f"),
        (r"([\d.]+)\s*°?f\s*(to|en|->)\s*°?c",      "f_c"),
        (r"([\d.]+)\s*°?c\s*(to|en|->)\s*k",        "c_k"),
        (r"([\d.]+)\s*kg\s*(to|en|->)\s*lbs?",      "kg_lbs"),
        (r"([\d.]+)\s*lbs?\s*(to|en|->)\s*kg",      "lbs_kg"),
        (r"([\d.]+)\s*g\s*(to|en|->)\s*oz",         "g_oz"),
        (r"([\d.]+)\s*km/?h\s*(to|en|->)\s*mph",    "kmh_mph"),
        (r"([\d.]+)\s*mph\s*(to|en|->)\s*km/?h",    "mph_kmh"),
        (r"([\d.]+)\s*l\s*(to|en|->)\s*gal",        "l_gal"),
        (r"([\d.]+)\s*gal\s*(to|en|->)\s*l",        "gal_l"),
    ]
    for pattern, key in patterns:
        m = re.match(pattern, expr)
        if m:
            val = float(m.group(1))
            c = CONVERSIONS[key]
            result = c[2](val)
            return f"{val} {c[0]}  =  {smart_format(result)} {c[1]}"
    return None

def smart_format(n):
    """Formate intelligemment un nombre."""
    if isinstance(n, complex):
        return str(n)
    if isinstance(n, float) and (math.isinf(n) or math.isnan(n)):
        return str(n)
    if n == int(n) and abs(n) < 1e15:
        return str(int(n))
    # Arrondi propre
    formatted = f"{n:.10g}"
    return formatted

# ─── Le Gardien ────────────────────────────────────────────────────────────
class Interdit(Exception):
    pass

BIN_OPS = {ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul,
           ast.Div: operator.truediv, ast.FloorDiv: operator.floordiv,
           ast.Mod: operator.mod, ast.Pow: operator.pow}
UN_OPS = {ast.UAdd: operator.pos, ast.USub: operator.neg}

def gardien_eval(expr):
    """Évalue seulement ce qui est autorisé. Jamais de eval()."""
    if len(expr) > 200:
        raise Interdit("trop long")
    tree = ast.parse(expr, mode="eval")

    def walk(n):
        if isinstance(n, ast.Expression):
            return walk(n.body)
        if isinstance(n, ast.Constant) and type(n.value) in (int, float, complex):
            return n.value
        if isinstance(n, ast.Name):
            if n.id.startswith("_"):
                raise Interdit("interdit")
            if n.id in SAFE_MATH:
                return SAFE_MATH[n.id]
            raise ValueError("inconnu")
        if isinstance(n, ast.UnaryOp) and type(n.op) in UN_OPS:
            return UN_OPS[type(n.op)](walk(n.operand))
        if isinstance(n, ast.BinOp) and type(n.op) in BIN_OPS:
            a, b = walk(n.left), walk(n.right)
            if isinstance(n.op, ast.Pow) and abs(b) > 1000:
                raise Interdit("trop grand")
            return BIN_OPS[type(n.op)](a, b)
        if isinstance(n, ast.Call) and not n.keywords:
            f = walk(n.func)
            if not callable(f):
                raise ValueError("pas une fonction")
            args = [walk(a) for a in n.args]
            if f is SAFE_MATH.get("fact") and args and args[0] > 500:
                raise Interdit("trop grand")
            return f(*args)
        raise Interdit("interdit")

    return walk(tree)

# ─── Lot 1 : maths, degrés, devises, surface, monnaie ──────────────────────
import json
MODE = {"deg": False}
TAUX_FILE = os.path.expanduser("~/.calc_taux.json")
TAUX = {"cfa": 1.0, "eur": 655.957, "usd": 570.0}   # valeur de 1 unité en CFA
try:
    with open(TAUX_FILE) as _f:
        TAUX.update({k: float(v) for k, v in json.load(_f).items() if k in TAUX})
except Exception:
    pass

def _trig(f):
    return lambda x: f(math.radians(x)) if MODE["deg"] else f(x)

def _atrig(f):
    return lambda x: math.degrees(f(x)) if MODE["deg"] else f(x)

def _fact(x):
    if x != int(x) or not 0 <= x <= 170:
        raise ValueError("fact")
    return math.factorial(int(x))

def _pow(a, b):
    if abs(b) > 1000:
        raise Interdit("trop grand")
    return pow(a, b)

SAFE_MATH.update({
    "sin": _trig(math.sin), "cos": _trig(math.cos), "tan": _trig(math.tan),
    "asin": _atrig(math.asin), "acos": _atrig(math.acos), "atan": _atrig(math.atan),
    "sinh": math.sinh, "cosh": math.cosh, "tanh": math.tanh,
    "sind": lambda x: math.sin(math.radians(x)),
    "cosd": lambda x: math.cos(math.radians(x)),
    "tand": lambda x: math.tan(math.radians(x)),
    "rad": math.radians, "deg": math.degrees,
    "fact": _fact, "gcd": math.gcd, "lcm": math.lcm,
    "hypot": math.hypot, "max": max, "min": min, "pow": _pow,
})

DEVISES = {"cfa": "cfa", "fcfa": "cfa", "xof": "cfa", "eur": "eur", "euro": "eur",
           "euros": "eur", "usd": "usd", "dollar": "usd", "dollars": "usd"}
NOMS = {"cfa": "CFA", "eur": "EUR", "usd": "USD"}
COUPURES = [10000, 5000, 2000, 1000, 500, 250, 200, 100, 50, 25, 10, 5, 1]

def _lot1(expr, apply=False):
    e = expr.strip().lower().replace(",", ".")
    num = r"(\d+(?:\.\d+)?)"
    # mode degrés / radians
    m = re.fullmatch(r"mode\s*(deg|degres|degrés|rad|radians)", e)
    if m:
        deg = m.group(1).startswith("deg")
        if apply:
            MODE["deg"] = deg
            return "mode degrés activé" if deg else "mode radians activé"
        return "Entrée pour passer en " + ("degrés" if deg else "radians")
    # taux usd 600
    m = re.fullmatch(rf"taux\s*(usd|eur)\s*{num}", e)
    if m:
        v = float(m.group(2))
        if v <= 0:
            return "⚠  taux invalide"
        if apply:
            TAUX[m.group(1)] = v
            try:
                with open(TAUX_FILE, "w") as f:
                    json.dump(TAUX, f)
            except Exception:
                pass
            return f"taux enregistré : 1 {m.group(1).upper()} = {smart_format(v)} CFA"
        return f"Entrée pour fixer 1 {m.group(1).upper()} = {smart_format(v)} CFA"
    # 5000 cfa to eur
    d = "|".join(DEVISES)
    m = re.fullmatch(rf"{num}\s*({d})\s*(?:to|en|->)\s*({d})", e)
    if m:
        v, a, b = float(m.group(1)), DEVISES[m.group(2)], DEVISES[m.group(3)]
        res = v * TAUX[a] / TAUX[b]
        return f"{smart_format(v)} {NOMS[a]}  =  {smart_format(round(res, 2))} {NOMS[b]}"
    # surface 5x4
    m = re.fullmatch(rf"surface\s*{num}\s*[x*×]\s*{num}", e)
    if m:
        a, b = float(m.group(1)), float(m.group(2))
        return f"{smart_format(a * b)} m²  (périmètre {smart_format(2 * (a + b))} m)"
    # monnaie 10000 - 7500
    m = re.fullmatch(rf"monnaie\s*{num}\s*(?:-|à|pour)\s*{num}", e)
    if m:
        diff = float(m.group(1)) - float(m.group(2))
        if diff < 0:
            return f"⚠  il manque {smart_format(-diff)}"
        if diff == 0:
            return "rien à rendre"
        txt = f"rendre {smart_format(diff)}"
        if diff == int(diff):
            reste, parts = int(diff), []
            for c in COUPURES:
                q, reste = divmod(reste, c)
                if q:
                    parts.append(f"{q}x{c}")
            txt += "  (" + " + ".join(parts) + ")"
        return txt
    return None

def try_lot1(expr, apply=False):
    try:
        return _lot1(expr, apply)
    except Exception:
        return None

# ─── Lot 2 : boutique (ventes, dettes, stock, rappels, facture) ────────────
from datetime import datetime
DATA_FILE = os.path.expanduser("~/.calc_data.json")
HIST_FILE = os.path.expanduser("~/calc_historique.txt")
FACT_DIR = os.path.expanduser("~/calc_factures")

def _load():
    try:
        with open(DATA_FILE) as f:
            d = json.load(f)
    except Exception:
        d = {}
    for k, v in (("ventes", []), ("dettes", {}), ("stock", {}), ("rappels", [])):
        d.setdefault(k, v)
    return d

def _save(d):
    with open(DATA_FILE, "w") as f:
        json.dump(d, f, ensure_ascii=False)

def _lot2(expr, apply=False):
    e = expr.strip().lower()
    num = r"(\d+(?:\.\d+)?)"
    nom = r"(\w[\w'-]*)"
    qte = rf"(?:\s*[x*]\s*{num})?"
    today = datetime.now().strftime("%Y-%m-%d")

    # vente riz 2500 x3
    m = re.fullmatch(rf"vente\s+{nom}\s+{num}{qte}", e)
    if m:
        n, pr = m.group(1), float(m.group(2))
        q = float(m.group(3)) if m.group(3) else 1.0
        txt = f"{n} {smart_format(pr)} x{smart_format(q)} = {smart_format(pr * q)}"
        if not apply:
            return "Entrée pour enregistrer : " + txt
        d = _load()
        d["ventes"].append({"d": today, "n": n, "p": pr, "q": q})
        if n in d["stock"]:
            d["stock"][n] = max(0, d["stock"][n] - q)
        _save(d)
        return "vente enregistrée : " + txt
    if e == "ventes":
        v = _load()["ventes"]
        jour = [x for x in v if x["d"] == today]
        t = sum(x["p"] * x["q"] for x in jour)
        tot = sum(x["p"] * x["q"] for x in v)
        return f"aujourd'hui {smart_format(t)} ({len(jour)} ventes) | total {smart_format(tot)}"

    # dette awa 5000   /   dette awa -2000 (paiement)
    m = re.fullmatch(rf"dette\s+{nom}\s+(-?\d+(?:\.\d+)?)", e)
    if m:
        n, v = m.group(1), float(m.group(2))
        if v == 0:
            return None
        if not apply:
            return f"Entrée pour noter : {n} {'+' if v > 0 else '-'}{smart_format(abs(v))}"
        d = _load()
        x = d["dettes"].get(n, 0) + v
        if x <= 0:
            d["dettes"].pop(n, None)
            msg = f"{n} ne doit plus rien"
        else:
            d["dettes"][n] = x
            msg = f"{n} doit {smart_format(x)}"
        _save(d)
        return msg
    if e == "dettes":
        dd = _load()["dettes"]
        if not dd:
            return "aucune dette"
        liste = ", ".join(f"{n} {smart_format(x)}" for n, x in sorted(dd.items(), key=lambda t: -t[1]))
        return f"total {smart_format(sum(dd.values()))} : {liste}"

    # stock riz +10  /  stock riz -2  /  stock riz  /  stock
    m = re.fullmatch(rf"stock\s+{nom}\s*([+-])\s*{num}", e)
    if m:
        n, sg, v = m.group(1), m.group(2), float(m.group(3))
        d = _load()
        x = d["stock"].get(n, 0) + (v if sg == "+" else -v)
        if x < 0:
            return "⚠  stock insuffisant"
        if not apply:
            return f"Entrée : {n} passe à {smart_format(x)}"
        d["stock"][n] = x
        _save(d)
        return f"stock {n} : {smart_format(x)}"
    m = re.fullmatch(rf"stock\s+{nom}", e)
    if m:
        x = _load()["stock"].get(m.group(1))
        return "inconnu" if x is None else f"{m.group(1)} : {smart_format(x)}"
    if e == "stock":
        st = _load()["stock"]
        return ", ".join(f"{n} {smart_format(x)}" for n, x in sorted(st.items())) or "stock vide"

    # rappel 17h appeler client  /  rappel 17h30 ...  /  rappels
    m = re.fullmatch(r"rappel\s+(\d{1,2})h(\d{2})?\s+(.+)", e)
    if m:
        h, mi = int(m.group(1)), int(m.group(2) or 0)
        if h > 23 or mi > 59:
            return "⚠  heure invalide"
        hh = f"{h:02d}:{mi:02d}"
        if not apply:
            return f"Entrée pour noter : {hh} {m.group(3)}"
        d = _load()
        d["rappels"].append({"d": today, "h": hh, "t": m.group(3)})
        _save(d)
        return f"rappel noté : {hh} {m.group(3)}"
    if e == "rappels":
        r = sorted((x["h"], x["t"]) for x in _load()["rappels"] if x["d"] == today)
        return " ; ".join(f"{h} {t}" for h, t in r) or "aucun rappel aujourd'hui"

    # facture riz 2500 x3, huile 1000 x2
    m = re.fullmatch(r"facture\s+(.+)", e)
    if m:
        lignes = []
        for part in re.split(r"[,;]", m.group(1)):
            mm = re.fullmatch(rf"\s*{nom}\s+{num}{qte}\s*", part)
            if not mm:
                return None
            pr = float(mm.group(2))
            q = float(mm.group(3)) if mm.group(3) else 1.0
            lignes.append((mm.group(1), pr, q))
        total = sum(pr * q for _, pr, q in lignes)
        if not apply:
            return f"total {smart_format(total)} ({len(lignes)} articles) - Entrée pour créer"
        os.makedirs(FACT_DIR, exist_ok=True)
        now = datetime.now()
        path = os.path.join(FACT_DIR, f"facture_{now:%Y%m%d_%H%M%S}.txt")
        with open(path, "w") as f:
            f.write(f"FACTURE  {now:%d/%m/%Y %H:%M}\n" + "-" * 34 + "\n")
            for n, pr, q in lignes:
                f.write(f"{n.capitalize():<12}{smart_format(pr):>8} x{smart_format(q):<4}{smart_format(pr * q):>8}\n")
            f.write("-" * 34 + f"\nTOTAL{smart_format(total):>29}\n")
        return f"facture créée : {os.path.basename(path)}"
    return None

def try_lot2(expr, apply=False):
    try:
        return _lot2(expr, apply)
    except Exception:
        return "⚠  erreur d'enregistrement" if apply else None

# ─── Lot 3 : PIN, thème, sauvegarde chiffrée, export ───────────────────────
import hashlib, hmac, secrets, shutil, subprocess
PIN_FILE = os.path.expanduser("~/.calc_pin.json")
CONF_FILE = os.path.expanduser("~/.calc_config.json")
BACKUP_DIR = os.path.expanduser("~/calc_sauvegardes")
SHARE_DIR = os.path.expanduser("~/storage/shared/Download")

def _conf_load():
    try:
        with open(CONF_FILE) as f:
            return json.load(f)
    except Exception:
        return {}

def _conf_save(c):
    with open(CONF_FILE, "w") as f:
        json.dump(c, f)

def apply_theme(stdscr):
    if _conf_load().get("theme") == "clair":
        pairs = [(1, curses.COLOR_BLUE, curses.COLOR_WHITE),
                 (2, curses.COLOR_GREEN, curses.COLOR_WHITE),
                 (3, curses.COLOR_MAGENTA, curses.COLOR_WHITE),
                 (4, curses.COLOR_BLACK, curses.COLOR_WHITE),
                 (5, curses.COLOR_RED, curses.COLOR_WHITE),
                 (6, curses.COLOR_WHITE, curses.COLOR_BLUE)]
    else:
        pairs = [(1, curses.COLOR_CYAN, -1), (2, curses.COLOR_GREEN, -1),
                 (3, curses.COLOR_YELLOW, -1), (4, curses.COLOR_WHITE, -1),
                 (5, curses.COLOR_RED, -1),
                 (6, curses.COLOR_BLACK, curses.COLOR_CYAN)]
    for n, fg, bg in pairs:
        curses.init_pair(n, fg, bg)
    stdscr.bkgd(" ", curses.color_pair(4))

def ask_secret(stdscr, label):
    """Saisie masquée. Renvoie None si Esc."""
    buf = ""
    while True:
        stdscr.erase()
        max_y, max_x = stdscr.getmaxyx()
        try:
            stdscr.addstr(2, 2, label[:max_x - 4], curses.color_pair(1) | curses.A_BOLD)
            stdscr.addstr(4, 2, ("*" * len(buf))[:max_x - 4] + " ", curses.color_pair(4))
            stdscr.addstr(6, 2, "[Entrée] valider  [Esc] annuler"[:max_x - 4], curses.color_pair(4))
        except curses.error:
            pass
        stdscr.refresh()
        k = stdscr.get_wch()
        if k in ("\n", "\r"):
            return buf
        if k in (27, "\x1b"):
            return None
        if k in (curses.KEY_BACKSPACE, "\x7f", "\b"):
            buf = buf[:-1]
        elif isinstance(k, str) and k.isprintable():
            buf += k

def _pin_hash(pin, salt):
    return hashlib.pbkdf2_hmac("sha256", pin.encode(), salt, 200000).hex()

def _pin_load():
    try:
        with open(PIN_FILE) as f:
            c = json.load(f)
        return c if c.get("salt") and c.get("hash") else None
    except Exception:
        return None

def _pin_ok(pin, cfg):
    return hmac.compare_digest(_pin_hash(pin, bytes.fromhex(cfg["salt"])), cfg["hash"])

def _pin_save(pin):
    salt = secrets.token_bytes(16)
    with open(PIN_FILE, "w") as f:
        json.dump({"salt": salt.hex(), "hash": _pin_hash(pin, salt)}, f)
    os.chmod(PIN_FILE, 0o600)

def pin_gate(stdscr):
    cfg = _pin_load()
    if not cfg:
        return True
    for essai in range(3):
        pin = ask_secret(stdscr, f"PIN ({3 - essai} essais) :")
        if pin is None:
            return False
        if _pin_ok(pin, cfg):
            return True
    return False

def _openssl(data, pw, decrypt=False):
    r, w = os.pipe()
    os.write(w, pw.encode() + b"\n")
    os.close(w)
    cmd = ["openssl", "enc", "-aes-256-cbc", "-salt", "-pbkdf2",
           "-iter", "200000", "-pass", f"fd:{r}"]
    if decrypt:
        cmd.insert(2, "-d")
    try:
        out = subprocess.run(cmd, input=data, capture_output=True,
                             pass_fds=(r,), timeout=30)
    finally:
        os.close(r)
    if out.returncode != 0:
        raise ValueError("openssl")
    return out.stdout

def _backup(stdscr, share):
    if not shutil.which("openssl"):
        return "⚠  pkg install openssl-tool"
    p1 = ask_secret(stdscr, "Mot de passe (6+ car.) :")
    if p1 is None:
        return "annulé"
    if len(p1) < 6:
        return "⚠  mot de passe trop court"
    if ask_secret(stdscr, "Confirme le mot de passe :") != p1:
        return "⚠  mots de passe différents"
    payload = json.dumps({"calc": 1, "data": _load(), "taux": TAUX},
                         ensure_ascii=False).encode()
    try:
        blob = _openssl(payload, p1)
    except Exception:
        return "⚠  échec du chiffrement"
    os.makedirs(BACKUP_DIR, exist_ok=True)
    name = f"calc_{datetime.now():%y%m%d_%H%M%S}.enc"
    path = os.path.join(BACKUP_DIR, name)
    with open(path, "wb") as f:
        f.write(blob)
    if os.path.isdir(SHARE_DIR):
        try:
            shutil.copy(path, os.path.join(SHARE_DIR, name))
        except OSError:
            pass
    if share and shutil.which("termux-share"):
        try:
            subprocess.run(["termux-share", "-a", "send", path],
                           capture_output=True, timeout=15)
            return f"partagée : {name}"
        except Exception:
            pass
    return f"chiffrée : {name}"

def _restore(stdscr, name):
    if not shutil.which("openssl"):
        return "⚠  pkg install openssl-tool"
    if name:
        n = os.path.basename(name)
        cands = [os.path.join(d, n) for d in (BACKUP_DIR, SHARE_DIR)]
    else:
        fs = []
        for d in (BACKUP_DIR, SHARE_DIR):
            if os.path.isdir(d):
                fs += [os.path.join(d, f) for f in os.listdir(d)
                       if f.startswith("calc_") and f.endswith(".enc")]
        cands = sorted(fs, key=os.path.getmtime, reverse=True)[:1]
    path = next((c for c in cands if os.path.isfile(c)), None)
    if not path:
        return "⚠  fichier introuvable"
    pw = ask_secret(stdscr, "Mot de passe :")
    if pw is None:
        return "annulé"
    try:
        with open(path, "rb") as f:
            blob = f.read()
        obj = json.loads(_openssl(blob, pw, decrypt=True).decode())
        if obj.get("calc") != 1 or not isinstance(obj["data"], dict):
            raise ValueError("format")
        data = obj["data"]
        taux = {k: float(v) for k, v in obj["taux"].items() if k in TAUX}
    except Exception:
        return "⚠  mot de passe ou fichier invalide"
    try:
        if os.path.exists(DATA_FILE):
            shutil.copy(DATA_FILE, DATA_FILE + ".avant_restauration")
    except OSError:
        pass
    _save(data)
    TAUX.update(taux)
    with open(TAUX_FILE, "w") as f:
        json.dump(TAUX, f)
    return f"restauré : {os.path.basename(path)}"

def _lot3(expr, stdscr=None, apply=False):
    e = expr.strip()
    low = e.lower()
    m = re.fullmatch(r"theme\s+(sombre|clair)", low)
    if m:
        t = m.group(1)
        if not apply:
            return f"Entrée pour le thème {t}"
        c = _conf_load()
        c["theme"] = t
        _conf_save(c)
        apply_theme(stdscr)
        return f"thème {t} activé"
    if low in ("pin", "pin off"):
        off = low == "pin off"
        if not apply:
            return "Entrée pour " + ("retirer le PIN" if off else "définir un PIN")
        cfg = _pin_load()
        if cfg:
            cur = ask_secret(stdscr, "PIN actuel :")
            if cur is None or not _pin_ok(cur, cfg):
                return "⚠  PIN incorrect"
        if off:
            try:
                os.remove(PIN_FILE)
            except OSError:
                pass
            return "PIN retiré"
        p1 = ask_secret(stdscr, "Nouveau PIN (4-8 chiffres) :")
        if p1 is None:
            return "annulé"
        if not re.fullmatch(r"\d{4,8}", p1):
            return "⚠  PIN : 4 à 8 chiffres"
        if ask_secret(stdscr, "Confirme le PIN :") != p1:
            return "⚠  les PIN diffèrent"
        _pin_save(p1)
        return "PIN enregistré"
    if low in ("sauvegarde", "export"):
        share = low == "export"
        if not apply:
            return "Entrée : sauvegarde chiffrée" + (" + partage" if share else "")
        return _backup(stdscr, share)
    m = re.fullmatch(r"restaure(?:\s+([\w.\-]+))?", e, re.I)
    if m:
        if not apply:
            return "Entrée : restaurer (remplace tout)"
        return _restore(stdscr, m.group(1))
    return None

def try_lot3(expr, stdscr=None, apply=False):
    if apply and stdscr is None:
        return None
    try:
        return _lot3(expr, stdscr, apply)
    except Exception:
        return "⚠  erreur" if apply else None

# ─── Lot 4 : coffre caché ──────────────────────────────────────────────────
import time
COFFRE_CONF = os.path.expanduser("~/.calc_coffre.json")
COFFRE_DIRS = {"vrai": os.path.expanduser("~/.calc_coffre"),
               "faux": os.path.expanduser("~/.calc_coffre_faux")}
COFFRE_TMP = os.path.expanduser("~/.calc_coffre_tmp")
SHARED = os.path.expanduser("~/storage/shared")
IDLE_LOCK = 60

def _cf_load():
    try:
        with open(COFFRE_CONF) as f:
            return json.load(f)
    except Exception:
        return {}

def _cf_save(c):
    with open(COFFRE_CONF, "w") as f:
        json.dump(c, f)
    os.chmod(COFFRE_CONF, 0o600)

def _cf_hash(code, salt):
    return hashlib.pbkdf2_hmac("sha256", code.encode(), salt, 50000).hex()

def _cf_set(c, which, code):
    salt = secrets.token_bytes(16)
    c[which] = {"salt": salt.hex(), "hash": _cf_hash(code, salt)}

def _cf_match(c, which, code):
    e = c.get(which)
    if not e:
        return False
    return hmac.compare_digest(_cf_hash(code, bytes.fromhex(e["salt"])), e["hash"])

def _ssl_file(src, dst, pw, decrypt=False):
    r, w = os.pipe()
    os.write(w, pw.encode() + b"\n")
    os.close(w)
    cmd = ["openssl", "enc", "-aes-256-cbc", "-salt", "-pbkdf2", "-iter", "200000",
           "-pass", f"fd:{r}", "-in", src, "-out", dst]
    if decrypt:
        cmd.insert(2, "-d")
    try:
        res = subprocess.run(cmd, capture_output=True, pass_fds=(r,), timeout=900)
    finally:
        os.close(r)
    if res.returncode != 0:
        try:
            os.remove(dst)
        except OSError:
            pass
        raise ValueError("openssl")

def _idx_load(d, pw):
    p = os.path.join(d, "index.enc")
    if not os.path.isfile(p):
        return {}
    with open(p, "rb") as f:
        return json.loads(_openssl(f.read(), pw, decrypt=True).decode())

def _idx_save(d, pw, idx):
    os.makedirs(d, exist_ok=True)
    os.chmod(d, 0o700)
    with open(os.path.join(d, "index.enc"), "wb") as f:
        f.write(_openssl(json.dumps(idx, ensure_ascii=False).encode(), pw))

def _h(n):
    for u in ("o", "Ko", "Mo", "Go"):
        if n < 1024:
            return f"{n:.0f}{u}"
        n /= 1024
    return f"{n:.1f}To"

def _resolve(path):
    p = os.path.expanduser(path.strip().strip("'\""))
    for c in (p, os.path.join(SHARED, p)):
        if os.path.isfile(c):
            return c
    return None

def _unique(path):
    base, ext = os.path.splitext(path)
    n, p = 1, path
    while os.path.exists(p):
        n += 1
        p = f"{base}_{n}{ext}"
    return p

def _vault_cmd(cmd, d, pw, idx):
    ids = sorted(idx, key=lambda k: idx[k]["t"])
    m = re.fullmatch(r"ajoute\s+(.+)", cmd, re.I)
    if m:
        src = _resolve(m.group(1))
        if not src:
            return "⚠  fichier introuvable"
        fid = secrets.token_hex(8)
        os.makedirs(d, exist_ok=True)
        os.chmod(d, 0o700)
        dst = os.path.join(d, fid + ".enc")
        try:
            _ssl_file(src, dst, pw)
            if os.path.getsize(dst) == 0:
                raise ValueError("vide")
        except Exception:
            return "⚠  échec du chiffrement"
        idx[fid] = {"nom": os.path.basename(src), "t": time.time(),
                    "taille": os.path.getsize(src)}
        _idx_save(d, pw, idx)
        try:
            os.remove(src)
            return "ajouté, original supprimé"
        except OSError:
            return "ajouté (⚠ original non supprimé)"
    m = re.fullmatch(r"(voir|rend|supprime)\s+(\d+)(\s+oui)?", cmd.lower())
    if m:
        n = int(m.group(2))
        if not 1 <= n <= len(ids):
            return "⚠  numéro inconnu"
        fid = ids[n - 1]
        safe = os.path.basename(idx[fid]["nom"]) or "fichier"
        enc = os.path.join(d, fid + ".enc")
        if m.group(1) == "supprime":
            if not m.group(3):
                return f"confirme : supprime {n} oui"
            try:
                os.remove(enc)
            except OSError:
                pass
            del idx[fid]
            _idx_save(d, pw, idx)
            return "supprimé"
        if m.group(1) == "voir":
            os.makedirs(COFFRE_TMP, mode=0o700, exist_ok=True)
            out = os.path.join(COFFRE_TMP, safe)
            _ssl_file(enc, out, pw, decrypt=True)
            if shutil.which("termux-open"):
                subprocess.Popen(["termux-open", out], stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)
                return "ouverture… (effacé à la fermeture)"
            return "⚠  termux-open absent, utilise rend"
        dest = SHARE_DIR if os.path.isdir(SHARE_DIR) else os.path.expanduser("~/coffre_sortie")
        os.makedirs(dest, exist_ok=True)
        out = _unique(os.path.join(dest, safe))
        _ssl_file(enc, out, pw, decrypt=True)
        os.remove(enc)
        del idx[fid]
        _idx_save(d, pw, idx)
        return "rendu : " + out.replace(os.path.expanduser("~"), "~")
    return "ajoute CHEMIN | voir N | rend N | supprime N oui"

def vault_screen(stdscr, which, pw):
    d = COFFRE_DIRS[which]
    try:
        idx = _idx_load(d, pw)
    except Exception:
        idx = {}
    msg = "ajoute CHEMIN | voir N | rend N | supprime N"
    buf, last = "", time.time()
    curses.curs_set(1)
    stdscr.timeout(1000)
    try:
        while True:
            ids = sorted(idx, key=lambda k: idx[k]["t"])
            stdscr.erase()
            my, mx = stdscr.getmaxyx()
            try:
                stdscr.addstr(1, 1, "COFFRE", curses.color_pair(1) | curses.A_BOLD)
                if not ids:
                    stdscr.addstr(3, 1, "(vide)", curses.color_pair(4))
                for i, fid in enumerate(ids[:max(0, my - 9)]):
                    e = idx[fid]
                    line = f"{i + 1}. {e['nom']} ({_h(e['taille'])})"
                    stdscr.addstr(3 + i, 1, line[:mx - 2], curses.color_pair(3))
                stdscr.addstr(my - 5, 1, msg[:mx - 2], curses.color_pair(2))
                stdscr.addstr(my - 3, 1, ("› " + buf)[-(mx - 2):],
                              curses.color_pair(4) | curses.A_BOLD)
                stdscr.addstr(my - 2, 1, "Esc = fermer"[:mx - 2], curses.color_pair(4))
                stdscr.move(my - 3, min(mx - 2, 3 + len(buf)))
            except curses.error:
                pass
            stdscr.refresh()
            try:
                k = stdscr.get_wch()
            except curses.error:
                if time.time() - last > IDLE_LOCK:
                    break
                continue
            last = time.time()
            if k in (27, "\x1b"):
                break
            if k in ("\n", "\r"):
                cmd, buf = buf.strip(), ""
                if cmd.lower() in ("fermer", "quitter", "q"):
                    break
                try:
                    msg = _vault_cmd(cmd, d, pw, idx)
                except Exception:
                    msg = "⚠  erreur"
            elif k in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                buf = buf[:-1]
            elif isinstance(k, str) and k.isprintable():
                buf += k
    finally:
        stdscr.timeout(-1)
        shutil.rmtree(COFFRE_TMP, ignore_errors=True)

def coffre_check(stdscr, code):
    """Appelé à chaque Entrée : le code ouvre le coffre (ou efface si panique)."""
    if len(code) < 6:
        return False
    c = _cf_load()
    if not c:
        return False
    if _cf_match(c, "panique", code):
        shutil.rmtree(COFFRE_DIRS["vrai"], ignore_errors=True)
        shutil.rmtree(COFFRE_TMP, ignore_errors=True)
        return True
    for which in ("vrai", "faux"):
        if _cf_match(c, which, code):
            try:
                vault_screen(stdscr, which, code)
            except Exception:
                pass
            curses.curs_set(1)
            return True
    return False

def _lot4(expr, stdscr=None, apply=False):
    m = re.fullmatch(r"coffre(?:\s+(code|faux|panique))?", expr.strip().lower())
    if not m:
        return None
    nom = m.group(1)
    c = _cf_load()
    if nom is None:
        return "coffre : " + ", ".join(
            f"{n} {'oui' if k in c else 'non'}"
            for n, k in (("code", "vrai"), ("faux", "faux"), ("panique", "panique")))
    which = {"code": "vrai", "faux": "faux", "panique": "panique"}[nom]
    if not apply:
        return f"Entrée pour définir le code {nom}"
    if not shutil.which("openssl"):
        return "⚠  pkg install openssl-tool"
    if which in c:
        cur = ask_secret(stdscr, "Code actuel :")
        if cur is None or not _cf_match(c, which, cur):
            return "⚠  code incorrect"
    if which != "panique":
        d = COFFRE_DIRS[which]
        if os.path.isdir(d) and any(f.endswith(".enc") and f != "index.enc"
                                    for f in os.listdir(d)):
            return "⚠  vide d'abord le coffre"
    p1 = ask_secret(stdscr, "Nouveau code (6+ caractères) :")
    if p1 is None:
        return "annulé"
    if len(p1) < 6:
        return "⚠  6 caractères minimum"
    if which == "panique" and evaluate(p1):
        return "⚠  ajoute une lettre (pas un calcul)"
    if any(k != which and _cf_match(c, k, p1) for k in ("vrai", "faux", "panique")):
        return "⚠  code déjà utilisé"
    if ask_secret(stdscr, "Confirme le code :") != p1:
        return "⚠  les codes diffèrent"
    _cf_set(c, which, p1)
    _cf_save(c)
    return "code enregistré"

def try_lot4(expr, stdscr=None, apply=False):
    if apply and stdscr is None:
        return None
    try:
        return _lot4(expr, stdscr, apply)
    except Exception:
        return "⚠  erreur" if apply else None

# ─── Lot 5 : mesure (GPS, 2 téléphones, terrain, hauteur) ──────────────────
import socket, ipaddress
PORT = 48765
R_TERRE = 6371000.0

def _status(stdscr, lignes):
    stdscr.erase()
    for i, t in enumerate(lignes):
        try:
            stdscr.addstr(2 + i, 2, t[:stdscr.getmaxyx()[1] - 4], curses.color_pair(1))
        except curses.error:
            pass
    stdscr.refresh()

def _gps(stdscr, label):
    """Position via Termux:API : (lat, lon, précision en m) ou None."""
    if not shutil.which("termux-location"):
        return None
    _status(stdscr, [label, "(quelques secondes, dehors c'est mieux)"])
    for prov in ("gps", "network"):
        try:
            out = subprocess.run(["termux-location", "-p", prov, "-r", "once"],
                                 capture_output=True, timeout=30)
            d = json.loads(out.stdout.decode())
            return float(d["latitude"]), float(d["longitude"]), float(d.get("accuracy", 0))
        except Exception:
            continue
    return None

def _dist(a, b):
    p1, p2 = math.radians(a[0]), math.radians(b[0])
    dp, dl = p2 - p1, math.radians(b[1] - a[1])
    h = math.sin(dp / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) ** 2
    return 2 * R_TERRE * math.asin(math.sqrt(h))

def _aire(pts):
    lat0 = sum(q[0] for q in pts) / len(pts)
    lon0 = sum(q[1] for q in pts) / len(pts)
    xy = [(R_TERRE * math.radians(q[1] - lon0) * math.cos(math.radians(lat0)),
           R_TERRE * math.radians(q[0] - lat0)) for q in pts]
    a = per = 0.0
    for i in range(len(xy)):
        x1, y1 = xy[i]
        x2, y2 = xy[(i + 1) % len(xy)]
        a += x1 * y2 - x2 * y1
        per += math.hypot(x2 - x1, y2 - y1)
    return abs(a) / 2, per

def _mon_ip():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("10.255.255.255", 1))
        return s.getsockname()[0]
    except OSError:
        return "?"
    finally:
        s.close()

def _set_derniere(txt):
    d = _load()
    d["derniere"] = txt
    _save(d)

def _mesure_serveur(stdscr):
    pos = _gps(stdscr, "Position de ce téléphone (point B)…")
    if not pos:
        return "⚠  position indisponible (Termux:API ?)"
    code = f"{secrets.randbelow(10000):04d}"
    ip = _mon_ip()
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        srv.bind(("", PORT))
        srv.listen(1)
        srv.settimeout(1.0)
    except OSError:
        srv.close()
        return "⚠  port occupé"
    t0, essais = time.time(), 0
    stdscr.nodelay(True)
    try:
        while time.time() - t0 < 120 and essais < 3:
            _status(stdscr, ["Point B : en attente de l'autre téléphone",
                             f"IP   : {ip}", f"CODE : {code}", "",
                             "Sur l'autre téléphone :",
                             f"mesure connecte {ip} {code}", "", "Esc = annuler"])
            try:
                k = stdscr.get_wch()
                if k in (27, "\x1b"):
                    return "annulé"
            except curses.error:
                pass
            try:
                conn, _ = srv.accept()
            except socket.timeout:
                continue
            with conn:
                conn.settimeout(5)
                try:
                    data = conn.recv(64).decode(errors="ignore").strip()
                except Exception:
                    continue
                if hmac.compare_digest(data.encode(), ("calc1 " + code).encode()):
                    conn.sendall((json.dumps({"lat": pos[0], "lon": pos[1],
                                              "acc": pos[2]}) + "\n").encode())
                    return "position envoyée à l'autre téléphone"
                conn.sendall(b"NO\n")
                essais += 1
        return "⚠  délai dépassé ou trop d'essais"
    finally:
        srv.close()
        stdscr.timeout(-1)

def _mesure_client(stdscr, ip, code):
    try:
        if not ipaddress.ip_address(ip).is_private:
            return "⚠  adresse locale seulement"
    except ValueError:
        return "⚠  IP invalide"
    mine = _gps(stdscr, "Position de ce téléphone (point A)…")
    if not mine:
        return "⚠  position indisponible (Termux:API ?)"
    _status(stdscr, ["Connexion à l'autre téléphone…"])
    try:
        with socket.create_connection((ip, PORT), timeout=8) as sk:
            sk.settimeout(8)
            sk.sendall(f"calc1 {code}".encode())
            data = sk.recv(512).decode(errors="ignore").strip()
    except Exception:
        return "⚠  connexion impossible (même Wi-Fi ?)"
    try:
        o = json.loads(data)
        other = (float(o["lat"]), float(o["lon"]), float(o.get("acc", 0)))
    except Exception:
        return "⚠  code incorrect"
    dist = _dist(mine, other)
    err = math.hypot(mine[2], other[2])
    txt = f"{smart_format(round(dist, 1))} m"
    _set_derniere("distance " + txt)
    return f"distance {txt} (± {smart_format(round(err))} m)"

def _lot5(expr, stdscr=None, apply=False):
    low = expr.strip().lower().replace(",", ".")
    if not low or low.split()[0] not in ("mesure", "mesures", "point", "terrain", "hauteur"):
        return None
    num = r"(\d+(?:\.\d+)?)"
    if low == "mesure serveur":
        if not apply:
            return "Entrée : ce téléphone attend l'autre (B)"
        return _mesure_serveur(stdscr)
    m = re.fullmatch(r"mesure\s+connecte\s+(\d{1,3}(?:\.\d{1,3}){3})\s+(\d{4})", low)
    if m:
        if not apply:
            return f"Entrée pour se connecter à {m.group(1)}"
        return _mesure_client(stdscr, m.group(1), m.group(2))
    if low == "point":
        d = _load()
        pts = d.setdefault("points", [])
        if not apply:
            return f"Entrée : ajouter ma position ({len(pts)} points)"
        pos = _gps(stdscr, "Position du point…")
        if not pos:
            return "⚠  position indisponible (Termux:API ?)"
        pts.append(list(pos))
        _save(d)
        return f"point {len(pts)} noté (± {smart_format(round(pos[2]))} m)"
    if low == "terrain efface":
        n = len(_load().get("points", []))
        if not apply:
            return f"Entrée pour effacer {n} points"
        d = _load()
        d["points"] = []
        _save(d)
        return "points effacés"
    if low == "terrain":
        pts = _load().get("points", [])
        if len(pts) < 3:
            return f"⚠  {len(pts)} point(s), il en faut 3 ou plus"
        aire, per = _aire(pts)
        acc = sum(q[2] for q in pts) / len(pts)
        txt = f"{smart_format(round(aire, 1))} m²  périm. {smart_format(round(per))} m"
        if apply:
            _set_derniere(txt)
        return txt + f"  GPS±{smart_format(round(acc))}m"
    m = re.fullmatch(rf"hauteur\s+{num}\s+angle\s+{num}\s*°?(?:\s+oeil\s+{num})?", low)
    if m:
        dist, ang = float(m.group(1)), float(m.group(2))
        oeil = float(m.group(3)) if m.group(3) else 0.0
        if not 0 < ang < 90:
            return "⚠  angle entre 0 et 90"
        txt = f"hauteur {smart_format(round(dist * math.tan(math.radians(ang)) + oeil, 2))} m"
        if apply:
            _set_derniere(txt)
        return txt
    m = re.fullmatch(r"mesure\s+enregistre\s+(\w[\w-]*)", low)
    if m:
        d = _load()
        der = d.get("derniere")
        if not der:
            return "⚠  rien à enregistrer"
        if not apply:
            return f"Entrée : enregistrer {m.group(1)} = {der}"
        d.setdefault("mesures", []).append(
            {"d": f"{datetime.now():%Y-%m-%d}", "nom": m.group(1), "v": der})
        _save(d)
        return f"mesure {m.group(1)} enregistrée"
    if low == "mesures":
        ms = _load().get("mesures", [])
        return " ; ".join(f"{x['nom']} {x['v']}" for x in ms[-5:]) or "aucune mesure"
    return None

def try_lot5(expr, stdscr=None, apply=False):
    if apply and stdscr is None:
        return None
    try:
        return _lot5(expr, stdscr, apply)
    except Exception:
        return "⚠  erreur" if apply else None

def try_percent(expr):
    """Pourcentages boutique."""
    e = expr.strip().lower().replace(",", ".")
    num = r"(\d+(?:\.\d+)?)"
    m = re.fullmatch(rf"prix\s*{num}\s*b[ée]n[ée]fice\s*{num}\s*%", e)
    if m:
        prix, pct = float(m.group(1)), float(m.group(2))
        gain = prix * pct / 100
        return f"vente {smart_format(prix + gain)}  (gain {smart_format(gain)})"
    m = re.fullmatch(rf"{num}\s*([+-])\s*{num}\s*%", e)
    if m:
        base, op, pct = float(m.group(1)), m.group(2), float(m.group(3))
        delta = base * pct / 100
        return smart_format(base + delta if op == "+" else base - delta)
    m = re.fullmatch(rf"{num}\s*%\s*(?:de|of)\s*{num}", e)
    if m:
        return smart_format(float(m.group(1)) * float(m.group(2)) / 100)
    return None

def evaluate(expr):
    """Évalue une expression mathématique."""
    if not expr.strip():
        return ""
    # Tenter conversion d'abord
    conv = try_conversion(expr)
    if conv:
        return conv
    pct = try_percent(expr)
    if pct:
        return pct
    lot = try_lot1(expr)
    if lot:
        return lot
    lot2 = try_lot2(expr)
    if lot2:
        return lot2
    lot3 = try_lot3(expr)
    if lot3:
        return lot3
    lot4 = try_lot4(expr)
    if lot4:
        return lot4
    lot5 = try_lot5(expr)
    if lot5:
        return lot5
    # Remplacements courants
    cleaned = expr.strip()
    cleaned = cleaned.replace("^", "**")
    cleaned = re.sub(r'(\d)\s*\(', r'\1*(', cleaned)   # 2(3) → 2*(3)
    cleaned = re.sub(r'\bmod\b', '%', cleaned)
    try:
        result = gardien_eval(cleaned)
        if isinstance(result, (int, float, complex)):
            return smart_format(result)
        return ""
    except Interdit:
        return "⚠  Interdit"
    except ZeroDivisionError:
        return "⚠  Division par zéro"
    except Exception:
        return ""

# ─── Interface curses ───────────────────────────────────────────────────────
def draw_ui(stdscr):
    curses.curs_set(1)
    curses.use_default_colors()

    # Couleurs
    curses.init_pair(1, curses.COLOR_CYAN,    -1)   # titre
    curses.init_pair(2, curses.COLOR_GREEN,   -1)   # résultat
    curses.init_pair(3, curses.COLOR_YELLOW,  -1)   # historique valeur
    curses.init_pair(4, curses.COLOR_WHITE,   -1)   # texte normal
    curses.init_pair(5, curses.COLOR_RED,     -1)   # erreur
    curses.init_pair(6, curses.COLOR_BLACK,   curses.COLOR_CYAN)  # header bg
    apply_theme(stdscr)
    if not pin_gate(stdscr):
        return

    history = deque(maxlen=8)   # derniers calculs
    expr = ""
    cursor_pos = len(expr)

    HELP_LINES = [
        "  sqrt(x)  sin(x)  cos(x)  log(x)  log2(x)",
        "  pi  e  tau  abs(x)  round(x)  x**n",
        "  100 km to miles  |  37 c to f  |  70 kg to lbs",
        "  prix 5000 benefice 20%  |  20% de 5000",
        "  surface 5x4  |  monnaie 10000 - 7500",
        "  5000 cfa to eur  |  taux usd 600",
        "  mode deg  |  mode rad  |  fact gcd lcm",
        "  vente riz 2500 x3  |  ventes",
        "  dette awa 5000  |  stock riz +10",
        "  rappel 17h appeler  |  facture riz 2500x3",
        "  pin | theme clair | sauvegarde | restaure",
        "  coffre | coffre code | coffre faux",
        "  point | terrain | hauteur 10 angle 35",
        "  mesure serveur | mesure connecte IP CODE",
    ]

    while True:
        stdscr.erase()
        max_y, max_x = stdscr.getmaxyx()
        W = min(max_x, 56)
        start_x = (max_x - W) // 2
        row = 1

        # ── Header ──────────────────────────────────────────────
        header = " ⚡ CALC — Termux Live Calculator "
        pad = (W - len(header)) // 2
        try:
            stdscr.addstr(row, start_x, "─" * W, curses.color_pair(1))
            stdscr.addstr(row + 1, start_x + pad, header, curses.color_pair(6) | curses.A_BOLD)
            stdscr.addstr(row + 2, start_x, "─" * W, curses.color_pair(1))
        except curses.error:
            pass
        row += 4

        # ── Zone de saisie ──────────────────────────────────────
        prompt = " › "
        try:
            stdscr.addstr(row, start_x, prompt, curses.color_pair(1) | curses.A_BOLD)
            stdscr.addstr(row, start_x + len(prompt), expr + " " * (W - len(prompt) - len(expr) - 1),
                          curses.color_pair(4) | curses.A_BOLD)
        except curses.error:
            pass
        row += 1

        # ── Ligne de séparation ─────────────────────────────────
        try:
            stdscr.addstr(row, start_x, "·" * W, curses.color_pair(1))
        except curses.error:
            pass
        row += 1

        # ── Résultat live ───────────────────────────────────────
        result = evaluate(expr)
        if result:
            eq_line = f"  = {result}"
            color = curses.color_pair(2) | curses.A_BOLD
            if "⚠" in result:
                color = curses.color_pair(5) | curses.A_BOLD
            try:
                stdscr.addstr(row, start_x, eq_line[:W], color)
            except curses.error:
                pass
        else:
            try:
                stdscr.addstr(row, start_x, "  ...", curses.color_pair(4))
            except curses.error:
                pass
        row += 2

        # ── Historique ──────────────────────────────────────────
        if history:
            try:
                stdscr.addstr(row, start_x, " Historique:", curses.color_pair(1))
            except curses.error:
                pass
            row += 1
            for (old_expr, old_res) in reversed(list(history)):
                line = f"  {old_expr[:20]:<20}  =  {old_res}"
                try:
                    stdscr.addstr(row, start_x, line[:W], curses.color_pair(3))
                except curses.error:
                    pass
                row += 1
            row += 1

        # ── Aide rapide ─────────────────────────────────────────
        try:
            stdscr.addstr(row, start_x, "─" * W, curses.color_pair(1))
            row += 1
            for line in HELP_LINES:
                stdscr.addstr(row, start_x, line[:W], curses.color_pair(4))
                row += 1
            stdscr.addstr(row, start_x, "─" * W, curses.color_pair(1))
            row += 1
            stdscr.addstr(row, start_x,
                          "  [Enter] sauvegarder  [Esc] quitter  [Ctrl+L] effacer",
                          curses.color_pair(4))
        except curses.error:
            pass

        # ── Positionner le curseur dans la saisie ───────────────
        cursor_col = start_x + len(prompt) + cursor_pos
        try:
            stdscr.move(5, min(cursor_col, max_x - 1))
        except curses.error:
            pass

        stdscr.refresh()

        # ── Lecture touche ──────────────────────────────────────
        key = stdscr.get_wch()

        if key in (27, "\x1b"):                          # Escape → quitter
            break
        elif key == "\x0c":                    # Ctrl+L → effacer
            expr = ""
            cursor_pos = 0
        elif key in (curses.KEY_BACKSPACE, "\x7f", "\b"):
            if cursor_pos > 0:
                expr = expr[:cursor_pos-1] + expr[cursor_pos:]
                cursor_pos -= 1
        elif key == curses.KEY_DC:             # Suppr
            if cursor_pos < len(expr):
                expr = expr[:cursor_pos] + expr[cursor_pos+1:]
        elif key == curses.KEY_LEFT:
            if cursor_pos > 0:
                cursor_pos -= 1
        elif key == curses.KEY_RIGHT:
            if cursor_pos < len(expr):
                cursor_pos += 1
        elif key == curses.KEY_HOME:
            cursor_pos = 0
        elif key == curses.KEY_END:
            cursor_pos = len(expr)
        elif key in ("\n", "\r"):              # Enter → sauvegarder dans historique
            if coffre_check(stdscr, expr.strip()):
                expr = ""
                cursor_pos = 0
                continue
            applied = try_lot1(expr, apply=True) or try_lot2(expr, apply=True) or try_lot3(expr, stdscr, apply=True) or try_lot4(expr, stdscr, apply=True) or try_lot5(expr, stdscr, apply=True)
            if applied:
                result = applied
            if expr.strip() and result and "⚠" not in result:
                history.append((expr.strip(), result))
                try:
                    with open(HIST_FILE, "a") as f:
                        f.write(f"{datetime.now():%Y-%m-%d %H:%M}  {expr.strip()}  =  {result}\n")
                except Exception:
                    pass
            expr = ""
            cursor_pos = 0
        elif isinstance(key, str) and key.isprintable():
            expr = expr[:cursor_pos] + key + expr[cursor_pos:]
            cursor_pos += 1


def main():
    curses.wrapper(draw_ui)


if __name__ == "__main__":
    main()
